{
  "name": "metaform-works",
  "version": "1.0.0",
  "description": "Metaform Works - Creative Digital Agency Website",
  "main": "index.html",
  "scripts": {
    "start": "node init && node server.js",
    "dev": "node init && node server.js",
    "serve": "serve . -l 3000",
    "sass": "sass src/scss:css --style=expanded --no-source-map",
    "sass:watch": "sass --watch src/scss:css --style=expanded --no-source-map"
  },
  "keywords": [
    "agency",
    "digital-agency",
    "portfolio",
    "landing-page",
    "metaform-works"
  ],
  "author": "Metaform Works",
  "license": "MIT",
  "allowScripts": {
    "@parcel/watcher": true
  },
  "devDependencies": {
    "sass": "^1.108.2",
    "serve": "^14.2.4"
  }
}
